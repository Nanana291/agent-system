{
  "name": "agent-system",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Agent-system CLI for validation, routing, sync, memory, and profile maintenance.",
  "bin": {
    "agent-system": "./bin/agent-system.mjs"
  },
  "scripts": {
    "validate": "node ./bin/agent-system.mjs validate",
    "route": "node ./bin/agent-system.mjs route",
    "explain": "node ./bin/agent-system.mjs explain",
    "gate": "node ./bin/agent-system.mjs gate",
    "profile": "node ./bin/agent-system.mjs profile",
    "sync": "node ./bin/agent-system.mjs sync",
    "lint": "node ./bin/agent-system.mjs lint",
    "init": "node ./bin/agent-system.mjs init",
    "memory": "node ./bin/agent-system.mjs memory",
    "memory-search": "node ./bin/agent-system.mjs memory search",
    "memory-promote": "node ./bin/agent-system.mjs memory promote",
    "memory-prune": "node ./bin/agent-system.mjs memory prune",
    "memory-audit": "node ./bin/agent-system.mjs memory audit",
    "memory-stats": "node ./bin/agent-system.mjs memory stats",
    "status": "node ./bin/agent-system.mjs status",
    "status-heartbeat": "node ./bin/agent-system.mjs status heartbeat",
    "status-who": "node ./bin/agent-system.mjs status who",
    "status-attach": "node ./bin/agent-system.mjs status attach",
    "watch": "node ./bin/agent-system.mjs status watch",
    "change": "node ./bin/agent-system.mjs change",
    "change-scout": "node ./bin/agent-system.mjs change scout",
    "change-auto-scaffold": "node ./bin/agent-system.mjs change auto-scaffold",
    "change-analyze": "node ./bin/agent-system.mjs change analyze",
    "change-scaffold": "node ./bin/agent-system.mjs change scaffold",
    "change-gate": "node ./bin/agent-system.mjs change gate",
    "memory-capture": "node ./bin/agent-system.mjs memory capture change",
    "export": "node ./bin/agent-system.mjs export",
    "import": "node ./bin/agent-system.mjs import"
  }
}

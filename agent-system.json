{
  "name": "agent-system",
  "version": "0.10.0.0",
  "schemaVersion": 1,
  "purpose": "Universal route, ownership, handoff, and delivery-gate scaffold that complements Superpowers.",
  "superpowersIntegration": {
    "mode": "complementary-process-layer",
    "divisionOfLabor": "Superpowers decides how to work; Agent System decides who owns what, what artifacts are required, and what proof closes delivery."
  },
  "supportedHosts": ["claude-code", "codex", "qwen-code", "opencode"],
  "bootstrap": {
    "primaryDocs": ["README.md", "AGENTS.md"],
    "hostDocs": {
      "claude": "CLAUDE.md",
      "codex": ".codex/INSTALL.md",
      "qwen": "QWEN.md",
      "opencode": "OPENCODE.md"
    }
  },
  "paths": {
    "commands": "commands",
    "skills": "skills",
    "agents": "agents",
    "adapters": "adapters",
    "profiles": "profiles",
    "templates": "templates",
    "docs": "docs",
    "luau": "docs/luau",
    "brain": "docs/brain",
    "upgrade": "docs/upgrade",
    "memory": "memory",
    "status": "status",
    "change": "change",
    "training": "docs/training",
    "evals": "docs/evals",
    "metrics": "docs/metrics"
  },
  "profileDiscovery": {
    "defaultProfile": "imphub",
    "profileManifest": "profiles/<profile>/profile.json",
    "humanProfileDoc": "profiles/<profile>/AGENTS.md"
  },
  "artifacts": {
    "taskLock": "templates/task-lock.md",
    "handoff": "templates/handoff.md",
    "deliveryGate": "templates/delivery-gate.md",
    "regressionMatrix": "templates/regression-matrix.md"
  },
  "adapters": {
    "claude": "adapters/claude/README.md",
    "codex": "adapters/codex/README.md",
    "qwen": "adapters/qwen/README.md",
    "opencode": "adapters/opencode/README.md"
  },
  "fallbackPolicy": {
    "missingHostAdapter": "Use the root docs and profile manifest directly.",
    "missingCommandSupport": "Emit the required artifact in markdown form.",
    "missingSubagentSupport": "Perform the review step manually in the host session."
  },
  "memory": {
    "system": "memory/system.md",
    "profile": "memory/profile/<profile>.md",
    "change": "memory/change/<host>.md",
    "packs": "memory/packs/<host>.md",
    "host": {
      "generic": "memory/host/generic.md",
      "claude": "memory/host/claude.md",
      "codex": "memory/host/codex.md",
      "qwen": "memory/host/qwen.md"
    },
    "schema": "docs/memory-schema.md"
  },
  "status": {
    "current": "status/current.json",
    "events": "status/events.jsonl",
    "readme": "status/README.md",
    "schema": "docs/status-schema.md"
  },
  "change": {
    "current": "change/current.json",
    "history": "change/history.jsonl",
    "readme": "change/README.md",
    "schema": "docs/change-schema.md",
    "intakeTemplate": "templates/change-intake.md"
  },
  "training": {
    "current": "docs/training/current.json",
    "history": "docs/training/history.jsonl",
    "readme": "docs/training/README.md",
    "schema": "docs/training-schema.md",
    "continuous": "docs/training/continuous.json",
    "continuousHistory": "docs/training/continuous-history.jsonl",
    "continuousReadme": "docs/training/continuous.md",
    "recovery": "docs/training/recovery"
  },
  "upgrade": {
    "current": "docs/upgrade/current.json",
    "history": "docs/upgrade/history.jsonl",
    "readme": "docs/upgrade/README.md",
    "sessions": "docs/upgrade/sessions"
  },
  "brain": {
    "current": "docs/brain/current.json",
    "history": "docs/brain/history.jsonl",
    "readme": "docs/brain/README.md",
    "schema": "docs/brain-schema.md",
    "snapshots": "docs/brain/snapshots"
  },
  "eval": {
    "current": "docs/evals/current.json",
    "history": "docs/evals/history.jsonl",
    "readme": "docs/evals/README.md",
    "schema": "docs/evals-schema.md"
  },
  "metrics": {
    "current": "docs/metrics/current.json",
    "history": "docs/metrics/history.jsonl",
    "readme": "docs/metrics/README.md",
    "snapshots": "docs/metrics/snapshots"
  },
  "backup": {
    "schema": "docs/backup-schema.md",
    "defaultOutput": "<profile>-backup.json"
  }
}
